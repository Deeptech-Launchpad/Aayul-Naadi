# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=aayu
# Generate with:  openssl rand -hex 24
# Use hex, not base64: this password is embedded in DATABASE_URL below, and
# base64's "+" and "/" are not valid there unencoded — Prisma then fails with
# "invalid port number in database URL", which is a confusing way to say it.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=aayu
DATABASE_URL=postgresql://aayu:change-me-to-a-long-random-string@db:5432/aayu?schema=public

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32 bytes, base64. Generate with:  openssl rand -base64 32
# Base64 is correct here — this one is a plain environment variable, not part
# of a URL, so + / = are fine.
# Losing this makes every record permanently undecryptable. Back it up offline.
AAYU_MASTER_KEY=

# ─── Claude ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Only for an identity-linked key — one the Console issued to you rather than
# to a workspace. Those are refused with a 400 until the request names the
# workspace it acts in. Find it in the Console URL while the workspace is
# open, or leave this blank and use a workspace-scoped key instead.
ANTHROPIC_WORKSPACE_ID=
AAYU_MODEL=claude-opus-5

# ─── App ─────────────────────────────────────────────────────────────────────
# Keeps container, volume and network names distinct from anything else on a
# shared server.
COMPOSE_PROJECT_NAME=aayu

# Only used in proxied mode: the loopback port your existing nginx/Caddy/Apache
# forwards to. `sh scripts/preflight.sh` suggests a free one.
AAYU_PORT=3000

# ─── Demo account ────────────────────────────────────────────────────────────
# Names one address that opens without a passphrase or an authenticator code,
# so the app can be shown to someone without handing them credentials. The
# sign-in page grows a "Look around the demo" button; every other account still
# needs both factors.
#
# Create the account with `npm run demo` after setting this. Leave it blank and
# there is no demo account and no button.
#
# Anyone who reaches the sign-in page can open it, and they all share one
# record — so point it only at an address holding the sample data, never at a
# real one.
AAYU_DEMO_EMAIL=

# ─── Who may create an account ───────────────────────────────────────────────
# open   = anyone who reaches the sign-up page (fine for a private instance
#          whose address nobody else knows)
# invite = an invite code is required — set AAYU_INVITE_CODE
# closed = nobody new; existing accounts still sign in
#
# The moment you give the address to anyone else, change this to `invite`.
AAYU_SIGNUP_MODE=open
AAYU_INVITE_CODE=
# Optional, and enforced in every mode: only these addresses may register.
AAYU_ALLOWED_EMAILS=

NODE_ENV=production
AAYU_ORIGIN=https://health.example.com
AAYU_DATA_DIR=/data/uploads
# Set to 1 only on a trusted LAN without TLS; cookies drop the Secure flag.
AAYU_INSECURE_COOKIES=0
